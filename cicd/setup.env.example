# Copy to setup.env and fill in. setup-gcp-wif.sh sources this on startup.
# setup.env is gitignored.

# Required.
PROJECT_ID=your-gcp-project
GH_REPO_OWNER=your-github-handle
GH_REPO_NAME=file-vault

# Optional — defaults shown.
# REGION=europe-west9
# AR_REPO=file-vault
# TFSTATE_BUCKET=${PROJECT_ID}-tfstate-file-vault
# WI_POOL=gitops-pool
# WI_PROVIDER=gh-provider
