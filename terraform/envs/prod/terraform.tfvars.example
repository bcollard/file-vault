# Copy to terraform.tfvars (gitignored). For CI, store the same content in the
# TFVARS secret of the GitHub environment "prod" (see README → Deploy).
project_id  = "your-gcp-project"
bucket_name = "your-gcp-project-file-vault-prod"
domain      = "file-vault.example.com"
alert_email = "you@example.com"

# Optional:
# region        = "europe-west9"
# max_upload_mb = 1024
# min_instances = 0
