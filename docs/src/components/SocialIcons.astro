---
// Overrides Starlight's SocialIcons to show the latest release next to the
// GitHub icon. The docs workflow sets RELEASE_VERSION and RELEASE_URL from the
// GitHub API at build time; with no release yet, the badge is hidden.
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const version = process.env.RELEASE_VERSION;
const url = process.env.RELEASE_URL;
---

{version && (
	<a class="release" href={url} title={`Latest release: ${version}`}>
		{version}
	</a>
)}
<Default />

<style>
	.release {
		align-self: center;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		line-height: 1;
		padding: 0.3rem 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		color: var(--sl-color-text-accent);
		text-decoration: none;
		white-space: nowrap;
	}
	.release:hover {
		border-color: var(--sl-color-text-accent);
	}
</style>
