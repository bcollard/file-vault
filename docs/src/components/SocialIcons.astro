---
// Overrides Starlight's SocialIcons to add, in the header's right-hand group:
//   - a "Docs" link to the first guide page
//   - the latest release version, next to the GitHub icon. The docs workflow
//     sets RELEASE_VERSION and RELEASE_URL from the GitHub API at build time;
//     with no release yet, the badge is hidden.
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docsHref = `${base}guides/how-it-works/`;
const inDocs = Astro.url.pathname !== base && Astro.url.pathname !== base.replace(/\/$/, '');

const version = process.env.RELEASE_VERSION;
const url = process.env.RELEASE_URL;
---

<a class="docs" href={docsHref} aria-current={inDocs ? 'page' : undefined}>Docs</a>
{version && (
	<a class="release" href={url} title={`Latest release: ${version}`}>
		{version}
	</a>
)}
<Default />

<style>
	.docs {
		align-self: center;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		padding: 0.25rem 0.5rem;
		border-radius: 0.375rem;
		white-space: nowrap;
	}
	.docs:hover,
	.docs[aria-current='page'] {
		color: var(--sl-color-text-accent);
	}
	.release {
		align-self: center;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		line-height: 1;
		padding: 0.3rem 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		color: var(--sl-color-text-accent);
		text-decoration: none;
		white-space: nowrap;
	}
	.release:hover {
		border-color: var(--sl-color-text-accent);
	}
</style>
